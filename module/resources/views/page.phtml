<script>
(() => {
    const provider = document.getElementById('ovo-provider');
    const model = document.getElementById('ovo-model');
    const groups = Array.from(model.querySelectorAll('optgroup'));
    const providerHelp = document.getElementById('ovo-provider-help');
    const modelHelp = document.getElementById('ovo-model-help');
    const resetModels = () => {
        model.replaceChildren(new Option('Kies een model van je provider', ''));
        const group = groups.find(group => group.dataset.provider === provider.value);
        if (group) model.append(group.cloneNode(true));
        model.disabled = !group;
        providerHelp.textContent = !provider.value ? 'Kies een provider. Er wordt niets automatisch geselecteerd.'
            : provider.selectedOptions[0].dataset.connected === '1' ? 'Deze provider is verbonden.'
            : 'Deze provider is nog niet verbonden. Meld je eerst aan via AI instellen.';
        modelHelp.textContent = group ? 'Kies zelf een model. Onderzoek vereist toolgebruik; voor scans is ook beeldherkenning nodig.'
            : provider.value ? 'Deze provider biedt nog geen modellen aan. Controleer AI instellen.' : 'Kies eerst een provider.';
    };
    provider.addEventListener('change', resetModels);
    model.addEventListener('change', () => {
        const option = model.selectedOptions[0];
        modelHelp.textContent = !model.value ? 'Kies zelf een model.' : option.dataset.tools !== '1'
            ? 'Dit model heeft geen bevestigd toolgebruik. Het kan daarom geen archiefonderzoek starten.'
            : option.dataset.image === '1' ? 'Toolgebruik en het lezen van afbeeldingen worden ondersteund.'
            : 'Toolgebruik wordt ondersteund. Dit model kan geen afbeeldingen rechtstreeks lezen.';
    });
    resetModels();
})();
</script>
