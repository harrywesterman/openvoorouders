<h3>Gesprek en voortgang</h3>
<p><a href="<?= e($module->url(['job'=>$details['job']['id']])) ?>">Voortgang vernieuwen</a> · Antwoorden en bronacties worden automatisch bijgewerkt.</p>
<label><input type="checkbox" id="ovo-follow" checked> Nieuwe uitvoer automatisch volgen</label>
<p id="ovo-live-status" role="status">Live voortgang verbonden.</p>
<div id="ovo-live-progress" class="ovo-log" tabindex="0" aria-label="Doorlopend onderzoekslog"><?= view('openvoorouders::progress', ['details'=>$details]) ?></div>
<?php View::push('javascript') ?>
<script>
(() => {
    const root = document.getElementById('ovo-live-progress');
    const notice = document.getElementById('ovo-live-status');
    const follow = document.getElementById('ovo-follow');
    root.addEventListener('scroll', () => { if (root.scrollHeight - root.scrollTop - root.clientHeight > 60) follow.checked = false; });
    follow.addEventListener('change', () => { if (follow.checked) root.scrollTop = root.scrollHeight; });
    const url = <?= json_encode($module->url(['job'=>$details['job']['id'], 'progress'=>'1']), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_THROW_ON_ERROR) ?>;
    const active = () => ['starting', 'running', 'stopping'].includes(root.firstElementChild?.dataset.state);
    const refresh = async () => {
        if (!active()) { notice.textContent = 'De laatste voortgang is geladen. Dit onderzoek is niet meer actief.'; return; }
        if (document.hidden) { setTimeout(refresh, 5000); return; }
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 15000);
        let delay = 3000;
        try {
            const response = await fetch(url, {credentials:'same-origin', cache:'no-store', signal:controller.signal});
            if (!response.ok || response.redirected) throw new Error('Voortgang niet bereikbaar');
            const html = await response.text();
            const fragment = new DOMParser().parseFromString(html, 'text/html').body.firstElementChild;
            if (!fragment?.matches('[data-ovo-progress]') || fragment.dataset.job !== root.firstElementChild.dataset.job) throw new Error('Ongeldige voortgang');
            const selection = window.getSelection();
            if (!selection?.isCollapsed && (root.contains(selection.anchorNode) || root.contains(selection.focusNode))) {
                notice.textContent = 'Live volgen blijft actief. Geselecteerde tekst wordt niet vervangen.';
            } else {
                if (fragment.outerHTML !== root.firstElementChild.outerHTML) {
                    const position = root.scrollTop;
                    root.replaceChildren(fragment);
                    root.scrollTop = follow.checked ? root.scrollHeight : position;
                }
                const card = Array.from(document.querySelectorAll('[data-ovo-job]')).find(card => card.dataset.ovoJob === fragment.dataset.job);
                if (card) {
                    card.querySelector('.ovo-job-state').textContent = fragment.dataset.label;
                    const stop = card.querySelector('.ovo-stop');
                    if (stop) stop.hidden = !active();
                }
                notice.textContent = active() ? 'Live bijgewerkt om ' + new Date().toLocaleTimeString('nl-NL')
                    : 'De laatste voortgang is geladen. Dit onderzoek is niet meer actief.';
            }
        } catch (error) {
            notice.textContent = 'De verbinding is onderbroken. We proberen het automatisch opnieuw; je onderzoek blijft behouden.';
            delay = 10000;
        } finally { clearTimeout(timeout); }
        if (active()) setTimeout(refresh, delay);
    };
    if (follow.checked) root.scrollTop = root.scrollHeight;
    refresh();
})();
</script>
